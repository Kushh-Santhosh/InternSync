# =============================================================================
# InternSync Environment Variables Specification
# =============================================================================
# Copy this file to .env and configure your keys for live production services.
# In local development without credentials, InternSync safely operates in
# isolated Interactive Demo Mode and surfaces truthful unconfigured states.
#
# DO NOT COMMIT REAL SECRETS OR .env FILES TO SOURCE CONTROL.
# =============================================================================

# 1. Supabase Backend (Required for Auth, Database Persistence, and Storage)
# - VITE_SUPABASE_URL: URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
# - VITE_SUPABASE_ANON_KEY: Public anonymous API key (JWT)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 2. OpenRouter AI & Live Web Search (Server-side only)
# - OPENROUTER_API_KEY: Secret API key for OpenRouter (e.g. sk-or-v1-...)
# - OPENROUTER_PRIMARY_MODEL: Primary model identifier
# - OPENROUTER_FALLBACK_MODELS: Comma-separated fallback models in order of priority
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_FALLBACK_MODELS=openai/gpt-4o-mini,google/gemini-2.0-flash-001,anthropic/claude-3.5-haiku

# 3. Adzuna Live Jobs API (Disabled — completely optional secondary source)
# No paid plan or subscription is required. Default is false.
ADZUNA_ENABLED=false
ADZUNA_APP_ID=
***REMOVED***
# ADZUNA_APP_KEY=
