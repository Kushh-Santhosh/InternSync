# InternSync Environment Variables (Documentation Example)
# Copy to .env and provide your secret credentials.
# DO NOT COMMIT REAL KEYS TO SOURCE CONTROL.

# OpenRouter AI & Web Search (Server-side only)
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=google/gemini-2.0-flash-001
OPENROUTER_FALLBACK_MODELS=anthropic/claude-3.5-haiku,meta-llama/llama-3.3-70b-instruct,openai/gpt-4o-mini
OPENROUTER_MODEL=auto

# Adzuna Jobs API
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# GitHub OAuth Integration (Read-only project evidence)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
